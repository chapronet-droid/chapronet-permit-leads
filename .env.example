# Optional Socrata application token. The system works without one,
# but a free token provides higher API rate limits.
SOCRATA_APP_TOKEN=

# Optional email delivery. Leave EMAIL_ENABLED=false until configured.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Send the email only when at least one new permit is found.
EMAIL_ONLY_WHEN_NEW=true
